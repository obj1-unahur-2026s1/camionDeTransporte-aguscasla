import cosas.*

describe "group of test for cosas" {
  method cargarLadrillos(cantidadLadrillos){
    paqueteLadrillos.agregarLadrillos(cantidadLadrillos)
  }
  method cargarContenedorPortuario(){
    contenedorPortuario.cargar(bateriaAntiaerea)
    contenedorPortuario.cargar(bumblebee)
    self.cargarLadrillos(12)
    contenedorPortuario.cargar(paqueteLadrillos)
  }

  test "test 01" {
    residuosRadioctivos.agregarPeso(30)
    embalajeDeSeguridad.embalarUnaCosa(residuosRadioctivos)
    assert.equals(30, embalajeDeSeguridad.peso())
  }

  test "test 02" {
    paqueteLadrillos.agregarLadrillos(32)
    assert.equals(64, paqueteLadrillos.peso())
  }

  test "test 03" {
    bateriaAntiaerea.cargarMisiles()
    assert.equals(300, bateriaAntiaerea.peso())
  }
  test "test 04" {
    bateriaAntiaerea.cargarMisiles()
    bateriaAntiaerea.descargarMisiles()
    assert.equals(0, bateriaAntiaerea.nivelPeligrosidad())
  }
  test "test 05" {
    self.cargarContenedorPortuario()
    assert.equals(1124, contenedorPortuario.peso())
  }
  test "test 06" {
    self.cargarContenedorPortuario()
    assert.equals(30, contenedorPortuario.nivelPeligrosidad())
  }
}